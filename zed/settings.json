// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "icon_theme": "Zed (Default)",
  "ui_font_size": 16,
  // Mono 변형은 한글 advance가 반각(500)이라 Zed에서 글자가 겹친다. 전각(1000)인 기본 변형을 쓴다.
  "buffer_font_family": "D2KodingLigature Nerd Font",
  "buffer_font_size": 13,
  "auto_install_extensions": {
    "sonokai": true,
  },
  "theme": {
    "mode": "dark",
    "light": "Ayu Light",
    "dark": "Sonokai",
  },
  // Sonokai 확장에 markdown capture가 없어서 vim sonokai 기준으로 보충
  "theme_overrides": {
    "Sonokai": {
      "syntax": {
        "title": { "color": "#fc5d7c", "font_weight": 700 },
        "emphasis": { "font_style": "italic" },
        "emphasis.strong": { "font_weight": 700 },
        "strikethrough": { "color": "#7f8490" },
        "text.literal": { "color": "#9ed072" },
        "link_text": { "color": "#b39df3" },
        "link_uri": { "color": "#76cce0", "font_style": "italic" },
        "punctuation.list_marker": { "color": "#fc5d7c" },
        "punctuation.embedded": { "color": "#7f8490" },
        "punctuation.markup": { "color": "#7f8490" },
      },
    },
  },
  "git": {
    "inline_blame": {
      "enabled": true,
      "delay_ms": 300,
    },
  },
  "terminal": {
    // kitty와 같은 D2Koding·크기 (Mono 변형은 위 이유로 제외)
    "font_family": "D2KodingLigature Nerd Font",
    "font_size": 13,
    "env": {
      "LANG": "en_US.UTF-8",
      "LC_ALL": "en_US.UTF-8",
    },
  },
}

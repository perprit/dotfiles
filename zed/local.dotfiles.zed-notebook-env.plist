<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.dotfiles.zed-notebook-env</string>
  <!-- 로그인 시 GUI 세션에 LOCAL_NOTEBOOK_DEV=1을 넣어 Dock/Finder로 켠 Zed에서도 노트북이 열리게 한다 -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/launchctl</string>
    <string>setenv</string>
    <string>LOCAL_NOTEBOOK_DEV</string>
    <string>1</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>
